<nav class="fcp-nav">
  {{#each tabs}}
  <button type="button" class="{{#if this.active}}active{{/if}}" data-action="switchTab" data-tab="{{this.id}}"><span class="fcp-nav-ic"><i class="{{this.icon}}"></i></span>{{this.label}}{{#if this.badge}}<span class="fcp-badge">{{this.badge}}</span>{{/if}}</button>
  {{/each}}
</nav>
