<section class="fcp-tab {{#if (eq activeTab 'chat')}}active{{/if}}" data-tab="chat">
  <div class="fcp-chat-log"></div>
  <div class="fcp-chat-compose">
    <input type="text" name="message" placeholder="{{localize 'FCP.ChatPlaceholder'}}" autocomplete="off" autocapitalize="off" data-enter="sendChat" value="{{chat.messageDraft}}">
    <button type="button" data-action="sendChat">{{localize "FCP.Send"}}</button>
  </div>
</section>
