<header class="fcp-header {{#if (eq activeTab 'sheet')}}big{{/if}} {{#if (eq activeTab 'map')}}fcp-hidden{{/if}}">
  <div class="fcp-kicker"><span>{{headerInfo.left}}</span><span>{{headerInfo.right}}</span></div>
  <div class="fcp-rule"></div>
  {{#if (eq activeTab 'chat')}}
  {{#if dice}}
  <div class="fcp-label">{{localize "FCP.QuickDice"}}</div>
  <div class="fcp-dicebar">
    {{#each chat.quickDice}}<button type="button" data-action="quickRoll" data-formula="{{this}}">{{this}}</button>{{/each}}
  </div>
  <div class="fcp-customroll">
    <input type="text" name="formula" placeholder="{{localize 'FCP.CustomRoll'}}" autocomplete="off" autocapitalize="off" data-enter="customRoll" value="{{chat.formulaDraft}}">
    <button type="button" class="fcp-primary" data-action="customRoll">{{localize "FCP.Roll"}}</button>
  </div>
  {{/if}}
  {{else}}
  <div class="fcp-identity">
    {{#if actor}}
    <img class="fcp-portrait" src="{{actor.img}}" alt="">
    <div class="fcp-name"><b>{{actor.name}}</b><small>{{#if (eq activeTab 'sheet')}}{{actor.subtitle}}{{else}}{{headerInfo.summary}}{{/if}}</small></div>
    {{else}}
    <img class="fcp-portrait" src="icons/svg/mystery-man.svg" alt="">
    <div class="fcp-name"><b>{{localize "FCP.Title"}}</b></div>
    {{/if}}
    {{#if (eq activeTab 'sheet')}}
    <div class="fcp-menu">
      <button type="button" data-action="refresh" title="{{localize 'FCP.Reload'}}"><i class="ph-duotone ph-arrows-clockwise"></i></button>
      <button type="button" data-action="exitCompanion" title="{{localize 'FCP.ExitCompanion'}}"><i class="ph-duotone ph-desktop"></i></button>
    </div>
    {{/if}}
  </div>
  {{#if (eq activeTab 'sheet')}}<div class="fcp-pin">{{headerInfo.pin}}</div>{{/if}}
  {{/if}}
</header>
