<section class="fcp-tab {{#if (eq activeTab 'sheet')}}active{{/if}}" data-tab="sheet">
  {{#if (gt actors.length 1)}}
  <div class="fcp-actorpicker">
    {{#each actors}}
    <button type="button" class="{{#if this.active}}active{{/if}}" data-action="selectActor" data-actor-id="{{this.id}}"><img src="{{this.img}}" alt="">{{this.name}}</button>
    {{/each}}
  </div>
  {{/if}}

  {{#unless actor}}
  <div class="fcp-empty">{{localize "FCP.NoActor"}}</div>
  {{else}}

  {{#if header.meters}}
  <div class="fcp-section" style="margin-bottom: 0">
    {{#each header.meters}}
    <div class="fcp-meter tone-{{this.tone}}">
      <div class="fcp-meter-head">
        <span class="fcp-label">{{this.label}}</span>
        <span class="fcp-meter-count">{{this.value}} <small>/ {{this.max}}</small></span>
      </div>
      <div class="fcp-boxes">
        {{#each this.boxes}}<button type="button" class="fcp-box {{#if this.on}}on{{/if}}" data-action="counter" data-key="{{../key}}" data-box="{{this.n}}" aria-label="{{../label}} {{this.n}}"></button>{{/each}}
      </div>
    </div>
    {{/each}}
  </div>
  {{#if header.hpEditor}}
  <div class="fcp-hp-editor">
    <input type="number" inputmode="numeric" name="hpAmount" placeholder="0" min="0" value="{{hpDraft}}" aria-label="{{localize 'FCP.HP'}}">
    <button type="button" class="fcp-btn" data-action="hpApply" data-sign="-1">{{localize "FCP.Damage"}}</button>
    <button type="button" class="fcp-btn" data-action="hpApply" data-sign="1">{{localize "FCP.Heal"}}</button>
  </div>
  {{/if}}
  {{else if header.hpBar}}
  <div class="fcp-hpblock">
    <div class="fcp-headrow"><span class="fcp-label">{{localize "FCP.D5.HP"}}</span><span class="fcp-section-note">{{localize "FCP.D5.HPLeft"}}</span></div>
    <div class="fcp-hpbig">
      <b>{{header.hpBar.value}}</b><span>/ {{header.hpBar.max}}</span>
      {{#if header.hpBar.temp}}<em>+{{header.hpBar.temp}} {{localize "FCP.D5.TempShort"}}</em>{{/if}}
    </div>
    <div class="fcp-hpbar"><i style="width: {{header.hpBar.hpPct}}"></i><i class="temp" style="width: {{header.hpBar.tempPct}}"></i></div>
    <div class="fcp-hpcontrols">
      <button type="button" data-action="hpDelta" data-delta="-1" aria-label="{{localize 'FCP.Damage'}} 1">−</button>
      <input type="number" inputmode="numeric" name="hpAmount" placeholder="0" min="0" value="{{hpDraft}}" aria-label="{{localize 'FCP.HP'}}">
      <button type="button" class="dmg" data-action="hpApply" data-sign="-1">{{localize "FCP.Damage"}}</button>
      <button type="button" class="heal" data-action="hpApply" data-sign="1">{{localize "FCP.Heal"}}</button>
    </div>
  </div>
  {{#if header.death}}
  <div class="fcp-death">
    <div class="fcp-death-title">{{localize "FCP.D5.Down"}}</div>
    <p>{{localize "FCP.D5.DeathHint"}}</p>
    {{#each header.death.rows}}
    <div class="fcp-death-row">
      <span>{{this.label}}</span>
      {{#each this.boxes}}<button type="button" class="fcp-box {{#if this.on}}on{{/if}}" data-action="counter" data-key="{{../key}}" data-box="{{this.n}}" aria-label="{{../label}} {{this.n}}">{{#if this.on}}×{{/if}}</button>{{/each}}
    </div>
    {{/each}}
    {{#if dice}}<button type="button" class="fcp-btn small" data-action="roll" data-kind="deathSave">{{localize "FCP.Roll"}}</button>{{/if}}
  </div>
  {{/if}}
  {{#if header.stats.length}}
  <div class="fcp-statrow">{{#each header.stats}}<div><b>{{this.value}}</b><span>{{this.label}}</span></div>{{/each}}</div>
  {{/if}}
  {{else}}
  <div class="fcp-section">
    {{#if header.hp}}
    <div class="fcp-stepper">
      <button type="button" data-action="hpDelta" data-delta="-1">−</button>
      <div><small>{{localize "FCP.HP"}}</small>{{header.hp.value}} / {{header.hp.max}}{{#if header.hp.temp}}<small> +{{header.hp.temp}}</small>{{/if}}</div>
      <button type="button" data-action="hpDelta" data-delta="1">+</button>
    </div>
    <div class="fcp-hp-editor">
      <input type="number" inputmode="numeric" name="hpAmount" placeholder="0" min="0" value="{{hpDraft}}">
      <button type="button" class="fcp-btn" data-action="hpApply" data-sign="-1">{{localize "FCP.Damage"}}</button>
      <button type="button" class="fcp-btn" data-action="hpApply" data-sign="1">{{localize "FCP.Heal"}}</button>
    </div>
    {{/if}}
    {{#each header.counters}}
    <div class="fcp-stepper">
      <button type="button" data-action="counter" data-key="{{this.key}}" data-delta="-1">−</button>
      <div><small>{{this.label}}</small>{{this.value}}{{#if this.max}} / {{this.max}}{{/if}}</div>
      <button type="button" data-action="counter" data-key="{{this.key}}" data-delta="1">+</button>
    </div>
    {{/each}}
    {{#if header.stats.length}}
    <div class="fcp-quickstats">{{#each header.stats}}<span>{{this.label}}<b>{{this.value}}</b></span>{{/each}}</div>
    {{/if}}
  </div>
  {{/if}}

  {{#if sheet.modes}}
  <div class="fcp-modebar">
    {{#each sheet.modes}}
    <button type="button" class="{{#if this.active}}active{{/if}}" data-action="setMode" data-mode="{{this.key}}">{{this.label}}</button>
    {{/each}}
  </div>
  {{/if}}

  {{#each sheet.sections}}
  <div class="fcp-section">
    {{#if (eq this.layout "thresholds")}}
    <div class="fcp-headrow"><span class="fcp-label">{{this.title}}</span>{{#if this.note}}<span class="fcp-section-note">{{this.note}}</span>{{/if}}</div>
    <div class="fcp-thresholds">
      {{#each this.bands}}
      {{#if this.cut}}<div class="cut"><span>{{this.cut}}</span></div>{{/if}}
      <div class="band"><b>{{this.range}}</b><small>{{this.sub}}</small></div>
      {{/each}}
    </div>

    {{else if (eq this.layout "boxes")}}
    <div class="fcp-headrow"><span class="fcp-label">{{this.title}}</span>{{#if this.note}}<span class="fcp-section-note">{{this.note}}</span>{{/if}}</div>
    {{#each this.rows}}
    <div class="fcp-meter tone-{{this.tone}}">
      {{#if this.label}}<div class="fcp-meter-head"><b>{{this.label}}</b><span class="fcp-meter-count">{{this.count}}</span></div>{{/if}}
      <div class="fcp-boxes">
        {{#each this.boxes}}<button type="button" class="fcp-box {{#if this.on}}on{{/if}}" data-action="counter" data-key="{{../key}}" data-box="{{this.n}}" aria-label="{{../label}} {{this.n}}"></button>{{/each}}
      </div>
    </div>
    {{/each}}
    {{#if ../dice}}{{#if this.roll}}<button type="button" class="fcp-btn small fcp-section-roll" data-action="roll" data-kind="{{this.roll.kind}}">{{this.roll.label}}</button>{{/if}}{{/if}}

    {{else if (eq this.layout "resources")}}
    <div class="fcp-headrow"><span class="fcp-label">{{this.title}}</span>{{#if this.note}}<span class="fcp-section-note">{{this.note}}</span>{{/if}}</div>
    <div class="fcp-lines compact">
      {{#each this.entries}}
      <button type="button" class="fcp-line fcp-resource" data-action="spendUse" data-item-id="{{this.id}}">
        <b>{{this.name}}{{#if this.recharge}}<small>{{this.recharge}}</small>{{/if}}</b>
        <span class="fcp-count {{#if this.spent}}spent{{/if}}">{{this.count}}</span>
      </button>
      {{/each}}
    </div>

    {{else if (eq this.layout "picker")}}
    <div class="fcp-label">{{this.title}}</div>
    <div class="fcp-chips">
      {{#each ../conditions}}{{#if this.active}}
      <button type="button" class="fcp-chip active" data-action="toggleStatus" data-status-id="{{this.id}}">{{this.name}}<i class="ph-duotone ph-x"></i></button>
      {{/if}}{{/each}}
      {{#unless ../conditionsActive}}<span class="fcp-chip-none">{{localize "FCP.D5.None"}}</span>{{/unless}}
      <button type="button" class="fcp-chip add" data-action="togglePicker"><i class="ph-duotone ph-{{#if ../condPicker}}minus{{else}}plus{{/if}}"></i>{{#if ../condPicker}}{{localize "FCP.D5.Close"}}{{else}}{{localize "FCP.D5.Add"}}{{/if}}</button>
    </div>
    {{#if ../condPicker}}
    <div class="fcp-chips fcp-picker">
      {{#each ../conditions}}<button type="button" class="fcp-chip {{#if this.active}}on{{/if}}" data-action="toggleStatus" data-status-id="{{this.id}}">{{this.name}}</button>{{/each}}
    </div>
    {{/if}}

    {{else if (eq this.layout "conditions")}}
    {{#if ../conditions.length}}
    <div class="fcp-label">{{this.title}}</div>
    <div class="fcp-chips">
      {{#each ../conditions}}
      <button type="button" class="fcp-chip {{#if this.active}}active{{/if}}" data-action="toggleStatus" data-status-id="{{this.id}}">{{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}</button>
      {{/each}}
    </div>
    {{/if}}

    {{else if (eq this.layout "notes")}}
    <div class="fcp-label">{{this.title}}</div>
    <div class="fcp-lines soft">
      {{#each this.lines}}<div class="fcp-line"><b>{{this.label}}</b>{{#if this.note}}<span>{{this.note}}</span>{{/if}}</div>{{/each}}
    </div>

    {{else if (eq this.layout "passives")}}
    <div class="fcp-label">{{this.title}}</div>
    {{#each this.entries}}
    <div class="fcp-passive"><b>{{this.name}}</b>{{#if this.text}}<p>{{this.text}}</p>{{/if}}</div>
    {{/each}}

    {{else if (eq this.layout "about")}}
    <div class="fcp-label">{{this.title}}</div>
    <div class="fcp-about">
      {{#if this.headline}}<div class="fcp-headline"><b>{{this.headline}}</b><span>{{this.note}}</span></div>{{/if}}
      {{#if this.text}}<p>{{this.text}}</p>{{/if}}
    </div>

    {{else if (eq this.layout "list")}}
    {{#if this.note}}<div class="fcp-headrow"><span class="fcp-label">{{this.title}}</span><span class="fcp-section-note">{{this.note}}</span></div>{{else}}<div class="fcp-label">{{this.title}}</div>{{/if}}
    <div class="fcp-lines {{this.variant}}">
      {{#each this.tiles}}
      <button type="button" class="fcp-line {{#if this.inactive}}inactive{{/if}} {{#if this.pinned}}pinned{{/if}}" data-action="{{this.action}}" {{#each this.data}}data-{{@key}}="{{this}}" {{/each}}>
        {{#if ../variant}}
        <b>{{this.label}}{{#if this.sub}}<small>{{this.sub}}</small>{{/if}}</b>
        {{#if this.marker}}<i class="fcp-marker">{{this.marker}}</i>{{/if}}
        {{else}}
        <b>{{this.label}}{{#if this.sub}}<br><small style="font: italic 12px var(--font-body); color: var(--color-neutral-600)">{{this.sub}}</small>{{/if}}</b>
        {{/if}}
        <span>{{this.value}}</span>
      </button>
      {{/each}}
      {{#if this.concentration}}
      <div class="fcp-line fcp-conc">
        <b>{{localize "FCP.D5.Concentration"}}<small>{{this.concentration.name}}</small></b>
        {{#if ../dice}}<button type="button" class="fcp-btn small" data-action="roll" data-kind="concentration">{{this.concentration.rollLabel}}</button>{{/if}}
        <button type="button" class="fcp-btn small danger" data-action="endConcentration">{{localize "FCP.D5.EndConc"}}</button>
      </div>
      {{/if}}
    </div>

    {{else}}
    <div class="fcp-label">{{this.title}}</div>
    <div class="fcp-grid {{#if this.cols}}cols-{{this.cols}}{{/if}} {{#if this.stack}}stack{{/if}}">
      {{#each this.tiles}}
      <button type="button" class="fcp-tile {{#if this.prof}}fcp-prof{{/if}} {{#if this.zero}}fcp-zero{{/if}} {{#if this.pinned}}pinned{{/if}}" data-action="{{this.action}}" {{#each this.data}}data-{{@key}}="{{this}}" {{/each}}>
        <span class="fcp-tile-label">{{this.label}}</span>
        <span class="fcp-tile-value">{{this.value}}</span>
        {{#if this.sub}}<span class="fcp-tile-sub">{{this.sub}}</span>{{/if}}
      </button>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/each}}

  {{#unless sheet.conditionsInline}}
  {{#if conditions.length}}
  <div class="fcp-section">
    <div class="fcp-label">{{localize "FCP.Conditions"}}</div>
    <div class="fcp-chips">
      {{#each conditions}}
      <button type="button" class="fcp-chip {{#if this.active}}active{{/if}}" data-action="toggleStatus" data-status-id="{{this.id}}">{{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}</button>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{/unless}}

  {{#if sheet.rests.length}}
  <div class="fcp-rests">
    {{#each sheet.rests}}
    <button type="button" data-action="rest" data-kind="{{this.kind}}">{{this.label}}</button>
    {{/each}}
  </div>
  {{/if}}
  {{/unless}}
</section>
