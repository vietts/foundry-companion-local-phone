# Copia in tools/offline.env (non finisce nel repo) e adatta.
FOUNDRY_SSH=user@mia-vps          # host ssh (anche un alias di ~/.ssh/config)
REMOTE_DATA=/opt/foundry/data/Data
REMOTE_BACKUPS=/opt/foundry/backups
CONTAINER=foundry                  # nome del container Docker di Foundry
# EXTRA_DIRS="czepeku file"        # altre cartelle di Data/ da portare sul portatile
