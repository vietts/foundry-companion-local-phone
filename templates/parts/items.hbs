<section class="fcp-tab {{#if (eq activeTab tabId)}}active{{/if}}" data-tab="{{tabId}}">
  {{#unless actor}}
  <div class="fcp-empty">{{localize "FCP.NoActor"}}</div>
  {{else}}
  {{#unless groups.length}}<div class="fcp-empty">{{localize "FCP.Empty"}}</div>{{/unless}}
  {{> "modules/foundry-companion-local-phone/templates/parts/targets.hbs"}}
  {{#each groups}}
  <div class="fcp-group {{#if this.spellbook}}fcp-spellbook{{/if}}">
    <div class="fcp-group-head">
      <span class="fcp-label">{{this.title}}</span>
      {{#if this.count}}<span class="fcp-section-note">{{this.count}}</span>{{/if}}
      {{#if this.slots}}
      <div class="fcp-meter fcp-group-slots tone-{{this.slots.tone}}">
        <div class="fcp-boxes">
          {{#each this.slots.boxes}}<button type="button" class="fcp-box {{#if this.on}}on{{/if}}" data-action="counter" data-key="{{../slots.key}}" data-box="{{this.n}}" aria-label="{{../title}} {{this.n}}"></button>{{/each}}
        </div>
      </div>
      {{/if}}
    </div>
    {{#if this.spellbook}}
    <input type="search" name="spellQuery" placeholder="{{localize 'FCP.D5.Search'}}" value="{{../spellQuery}}" autocomplete="off" autocapitalize="off">
    <div class="fcp-segmented">
      <button type="button" class="{{#if (eq ../spellFilter 'all')}}active{{/if}}" data-action="spellFilter" data-filter="all">{{localize "FCP.D5.All"}}</button>
      <button type="button" class="{{#if (eq ../spellFilter 'prepared')}}active{{/if}}" data-action="spellFilter" data-filter="prepared">{{localize "FCP.D5.OnlyPrepared"}}</button>
    </div>
    {{#each this.adders}}
    <button type="button" class="fcp-add-spells" data-action="addSpells" data-class-id="{{this.classId}}"><i class="ph-duotone ph-plus"></i> {{this.label}}</button>
    {{/each}}
    <div class="fcp-group-card">
    {{#each this.levels}}
    <div class="fcp-spell-level">
      <div class="fcp-sublabel">{{this.title}}</div>
      {{#each this.spells}}
      <div class="fcp-spell" data-name="{{this.search}}" data-prepared="{{#if this.prepared}}1{{else}}0{{/if}}">
        <span class="fcp-row-main"><span class="fcp-spell-name">{{this.name}}</span>{{#if this.school}}<small>{{this.school}}</small>{{/if}}</span>
        {{#if this.always}}
        <em>{{localize "FCP.D5.Always"}}</em>
        {{else}}
        <button type="button" class="fcp-switch {{#if this.prepared}}on{{/if}}" role="switch" aria-checked="{{#if this.prepared}}true{{else}}false{{/if}}" data-action="toggleItem" data-item-id="{{this.id}}" title="{{localize 'FCP.Prepared'}}"><i></i></button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/each}}
    <div class="fcp-empty fcp-spell-empty" hidden>{{localize "FCP.D5.NoSpells"}}</div>
    </div>
    {{/if}}
    {{#if this.items.length}}
    <div class="fcp-group-card">
    {{#each this.items}}
    <div class="fcp-item {{#if this.expanded}}expanded{{/if}}">
      <div class="fcp-row-line">
      <button type="button" class="fcp-row {{#if this.inactive}}fcp-inactive{{/if}} {{#if this.big}}big{{/if}}" {{#if this.id}}data-action="expandItem" data-item-id="{{this.id}}" aria-expanded="{{#if this.expanded}}true{{else}}false{{/if}}"{{else}}data-action="noop"{{/if}}>
        <img src="{{this.img}}" alt="">
        <span class="fcp-row-main">
          <span class="fcp-row-title">{{this.name}}</span>
          {{#if (or this.meta this.badge)}}<span class="fcp-row-meta">{{#if this.action}}{{#if this.badge}}{{#unless this.badge.hit}}<em>{{this.badge.text}}</em>{{#if this.meta}} · {{/if}}{{/unless}}{{/if}}{{/if}}{{this.meta}}</span>{{/if}}
        </span>
        <span class="fcp-row-right">
          {{#if this.uses}}<span class="fcp-uses">{{this.uses.value}}/{{this.uses.max}}</span>{{/if}}
          {{#unless this.action}}
          {{#if this.badge}}<span class="fcp-tohit" title="{{this.badge.hint}}">{{this.badge.text}}</span>{{/if}}
          {{#if this.id}}<i class="ph-duotone ph-caret-{{#if this.expanded}}up{{else}}down{{/if}} fcp-chevron"></i>{{/if}}
          {{/unless}}
        </span>
      </button>
      {{#if this.action}}
      <button type="button" class="fcp-use" data-action="{{this.action}}" data-item-id="{{this.id}}" {{#each this.data}}data-{{@key}}="{{this}}" {{/each}} {{#if this.badge.hit}}title="{{this.actionLabel}} · {{this.badge.hint}}"{{/if}}>{{#if this.badge.hit}}<i class="ph-duotone ph-sword"></i><b>{{this.badge.text}}</b>{{else}}{{this.actionLabel}}{{/if}}</button>
      {{/if}}
      </div>
      {{#if this.expanded}}
      <div class="fcp-item-body">
        <div class="fcp-item-desc">{{{this.description}}}</div>
        {{#if (or this.vfx this.toggle)}}
        <div class="fcp-item-actions">
          {{#if this.vfx}}
          <button type="button" class="fcp-btn small fcp-play" data-action="playVfx" data-item-id="{{this.id}}" data-vfx-action="{{this.vfx.actionId}}" {{#if ../../targets.noToken}}disabled{{/if}}>{{> "modules/foundry-companion-local-phone/templates/parts/icon.hbs" i="play"}}{{localize "FCP.Vfx.Only"}}</button>
          {{/if}}
          {{#if this.toggle}}
          <button type="button" class="fcp-btn small" data-action="{{this.toggle.action}}" data-item-id="{{this.id}}"><i class="{{this.toggle.icon}}"></i>{{this.toggle.label}}</button>
          {{#each this.extra}}<button type="button" class="fcp-btn small" data-action="{{this.action}}" data-item-id="{{../id}}" {{#each this.data}}data-{{@key}}="{{this}}" {{/each}}><i class="{{this.icon}}"></i>{{this.label}}</button>{{/each}}
          {{/if}}
        </div>
        {{/if}}
      </div>
      {{/if}}
    </div>
    {{/each}}
    </div>
    {{/if}}
  </div>
  {{/each}}
  {{/unless}}
</section>
