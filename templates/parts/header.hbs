<header class="fcp-header">
  {{#if actor}}
  <img class="fcp-portrait" src="{{actor.img}}" alt="">
  <div class="fcp-name">{{actor.name}}<small>{{actor.subtitle}}</small></div>
  {{else}}
  <img class="fcp-portrait" src="icons/svg/mystery-man.svg" alt="">
  <div class="fcp-name">{{localize "FCP.Title"}}</div>
  {{/if}}
  <div class="fcp-menu">
    <button type="button" data-action="refresh" title="{{localize 'FCP.Reload'}}"><i class="fas fa-rotate"></i></button>
    <button type="button" data-action="exitCompanion" title="{{localize 'FCP.ExitCompanion'}}"><i class="fas fa-desktop"></i></button>
  </div>
  {{#if actor}}
  <div class="fcp-stats">
    {{#if header.hp}}
    <div class="fcp-hp">
      <button type="button" data-action="hpDelta" data-delta="-1">−</button>
      <div class="fcp-hp-value">{{header.hp.value}} / {{header.hp.max}}{{#if header.hp.temp}}<small> +{{header.hp.temp}}</small>{{/if}}</div>
      <button type="button" data-action="hpDelta" data-delta="1">+</button>
    </div>
    {{/if}}
    {{#each header.stats}}
    <div class="fcp-stat"><span class="fcp-stat-label">{{this.label}}</span><span class="fcp-stat-value">{{this.value}}</span></div>
    {{/each}}
  </div>
  {{/if}}
</header>
