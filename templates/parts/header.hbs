<header class="fcp-header {{#if (eq headerTab 'sheet')}}big{{/if}} {{#if (eq headerTab 'map')}}fcp-hidden{{/if}}">
  {{#if (eq headerTab 'chat')}}
  <div class="fcp-kicker"><span>{{headerInfo.left}}</span><span>{{headerInfo.right}}</span></div>
  {{#if dice}}
  <div class="fcp-dicebar">
    {{#each chat.quickDice}}<button type="button" data-action="quickRoll" data-formula="{{this}}">{{this}}</button>{{/each}}
  </div>
  <div class="fcp-customroll">
    <input type="text" name="formula" placeholder="{{localize 'FCP.CustomRoll'}}" autocomplete="off" autocapitalize="off" data-enter="customRoll" value="{{chat.formulaDraft}}">
    <button type="button" class="fcp-primary" data-action="customRoll">{{localize "FCP.Roll"}}</button>
  </div>
  {{/if}}
  {{else}}
  <div class="fcp-identity">
    {{#if actor}}
    <img class="fcp-portrait" src="{{actor.img}}" alt="">
    <div class="fcp-name"><b>{{actor.name}}</b><small>{{#if (eq headerTab 'sheet')}}{{actor.subtitle}}{{else}}{{headerInfo.summary}}{{/if}}</small></div>
    {{else}}
    <img class="fcp-portrait" src="icons/svg/mystery-man.svg" alt="">
    <div class="fcp-name"><b>{{localize "FCP.Title"}}</b></div>
    {{/if}}
    {{#if headerInfo.menu}}
    {{!-- One «⋯» instead of three buttons by the name: reload, desktop and log out are rare and should not be one tap away. --}}
    <details class="fcp-more">
      <summary title="{{localize 'FCP.Menu'}}" aria-label="{{localize 'FCP.Menu'}}">{{> "modules/foundry-companion-local-phone/templates/parts/icon.hbs" i="dots"}}</summary>
      <div class="fcp-more-menu">
        <button type="button" data-action="refresh"><i class="ph-duotone ph-arrows-clockwise"></i>{{localize "FCP.Reload"}}</button>
        {{#if headerInfo.exits}}
        <button type="button" data-action="exitCompanion"><i class="ph-duotone ph-desktop"></i>{{localize "FCP.ExitCompanionShort"}}</button>
        <button type="button" data-action="logOut"><i class="ph-duotone ph-sign-out"></i>{{localize "FCP.LogOutShort"}}</button>
        {{/if}}
      </div>
    </details>
    {{/if}}
  </div>
  {{#if headerInfo.pin}}<div class="fcp-pin">{{headerInfo.pin}}</div>{{/if}}
  {{#if (eq headerTab 'sheet')}}{{#if panes}}
  <div class="fcp-panes">
    {{#each panes}}<button type="button" class="{{#if this.active}}active{{/if}}" data-action="switchPane" data-pane="{{this.key}}">{{this.label}}</button>{{/each}}
  </div>
  {{/if}}{{/if}}
  {{/if}}
</header>
